{
  "info": {
    "_postman_id": "7b8d4f12-0c9a-4e2b-b8c1-123456789abc",
    "name": "CloudCost AI – API Testing",
    "description": "Comprehensive REST API test collection for CloudCost AI FinOps Platform (Milestone 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root Endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Root API envelope structure is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"success\", true);",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "    pm.expect(jsonData).to.have.property(\"data\");",
              "    pm.expect(jsonData).to.have.property(\"timestamp\");",
              "});",
              "",
              "pm.test(\"Root metadata matches CloudCost AI platform\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.platform).to.eql(\"CloudCost AI\");",
              "    pm.expect(jsonData.data.status).to.eql(\"ONLINE\");",
              "    pm.expect(jsonData.data.endpoints).to.be.an(\"object\");",
              "    pm.expect(jsonData.data.endpoints.health).to.eql(\"GET /api/health\");",
              "    pm.expect(jsonData.data.endpoints.status).to.eql(\"GET /api/status\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Fetches root platform information, versioning, and primary endpoint discovery links."
      },
      "response": []
    },
    {
      "name": "Health Endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Health payload structure is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"success\", true);",
              "    pm.expect(jsonData.data).to.have.property(\"status\");",
              "    pm.expect(jsonData.data).to.have.property(\"database\");",
              "    pm.expect(jsonData.data).to.have.property(\"components\");",
              "    pm.expect(jsonData.data).to.have.property(\"uptimeSeconds\");",
              "});",
              "",
              "pm.test(\"Application status is UP and Database is CONNECTED\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.status).to.eql(\"UP\");",
              "    pm.expect(jsonData.data.database).to.eql(\"CONNECTED\");",
              "    pm.expect(jsonData.data.components.database.status).to.eql(\"UP\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Probes operational health of Spring Boot and MySQL 8 database connectivity."
      },
      "response": []
    },
    {
      "name": "Status Endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Status payload structure is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"success\", true);",
              "    pm.expect(jsonData.data).to.have.property(\"application\");",
              "    pm.expect(jsonData.data).to.have.property(\"javaVersion\");",
              "    pm.expect(jsonData.data).to.have.property(\"springBootVersion\");",
              "    pm.expect(jsonData.data).to.have.property(\"activeModules\");",
              "    pm.expect(jsonData.data).to.have.property(\"memory\");",
              "});",
              "",
              "pm.test(\"Runtime metadata matches expected specifications\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.application).to.include(\"CloudCost AI\");",
              "    pm.expect(jsonData.data.activeModules).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(jsonData.data.memory.usedMemoryMb).to.be.a(\"number\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "status"
          ]
        },
        "description": "Returns detailed runtime diagnostics, memory meters, and active subsystems."
      },
      "response": []
