# ===================================================================
# CloudCost AI - Global .gitignore
# ===================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.secret
*.key

# Java & Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# Node.js & Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local

# IDEs & System Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker volumes
mysql_data/
docker-compose.override.yml

# Generated runtime reports storage
backend/reports_storage/
reports_storage/
