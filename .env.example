# ===================================================================
# CloudCost AI - Environment Variables Reference (.env.example)
# Copy to .env and adjust values for your local or cloud environment.
# Never commit real credentials to version control.
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# -------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Connectivity
DB_URL=jdbc:mysql://localhost:3306/cloudcost_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Hibernate Schema Policy (update for dev, validate for prod)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Cloud Credential Encryption (AES-256-GCM 32-byte / 64-hex-char key)
CLOUD_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Background Schedulers (Disabled by default in dev, toggle in prod)
BILLING_SYNC_SCHEDULE_ENABLED=false
ANOMALY_SCHEDULE_ENABLED=false
OPTIMIZATION_SCHEDULE_ENABLED=false

# Connection Pooling & Reports Storage
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
REPORTS_STORAGE_DIR=reports_storage

# -------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
